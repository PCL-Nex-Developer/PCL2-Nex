<local:MyPageRight x:Class="PCL.PagePluginsInstalled"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Title="已安装插件" Margin="0,15,0,15">
                <StackPanel x:Name="PanInstalled" Margin="25,40,25,15">
                    <TextBlock x:Name="TextEmptyInstalled" Text="暂无已安装插件" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,5" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Title="插件更新" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MyCheckBox x:Name="CheckPluginAutoUpdate" Text="启动后自动检查插件更新" Height="22"
                                          Change="CheckPluginAutoUpdate_Change"
                                          ToolTip="启动后只检查并记录可用更新，插件文件需要在此页面手动更新。" />
                        <local:MyButton Grid.Column="1" Text="检查更新" x:Name="BtnCheckPluginUpdates"
                                        Click="BtnCheckPluginUpdates_Click" Margin="10,0,0,0" Height="30" MinWidth="90" />
                    </Grid>
                    <StackPanel x:Name="PanPluginUpdates" Margin="0,12,0,0">
                        <TextBlock Text="尚未检查更新。" FontSize="13" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Title="安装插件" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="可通过远程 manifest 安装，也可从本地 .pclx 或 .zip 插件包导入。" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <local:MyButton Grid.Column="1" Text="远程安装" x:Name="BtnInstallUrl" Click="BtnInstallUrl_Click" Margin="10,0,0,0" Height="30" MinWidth="80" />
                        <local:MyButton Grid.Column="2" Text="导入插件包" x:Name="BtnInstallZip" Click="BtnInstallZip_Click" Margin="8,0,0,0" Height="30" MinWidth="90" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
