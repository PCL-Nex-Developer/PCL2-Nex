<local:MyPageRight x:Class="PCL.PageToolsPlugins"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">

            <local:MyCard Title="插件商店" Margin="0,15,0,15">
                <StackPanel Margin="25,40,25,15">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TextRepoInfo"
                                   Text="正在加载插件列表..."
                                   FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <local:MyTextBox x:Name="TxtSearch" Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                                         FontSize="13" Padding="8,0" Margin="12,0,0,0" />
                        <local:MyButton Grid.Column="2" Text="搜索"
                                        x:Name="BtnSearch" Click="BtnSearch_Click"
                                        Margin="8,0,0,0" Height="30" MinWidth="62" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource ColorBrushGray6}" Margin="0,0,0,8" />
                    <StackPanel x:Name="PanPlugins">
                        <TextBlock x:Name="TextLoading"
                                   Text="正在从仓库获取插件列表..."
                                   FontSize="13" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Title="插件工具面板" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,15">
                    <local:PluginTabHost x:Name="TabHostPlugins" />
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
