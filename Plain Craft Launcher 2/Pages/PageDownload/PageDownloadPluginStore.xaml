<local:MyPageRight x:Class="PCL.PageDownloadPluginStore"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <Grid>
        <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
            <StackPanel x:Name="PanMain" Margin="25">
                <local:MySearchBox x:Name="PanSearchBox" Margin="0,0,0,15" SearchButtonVisibility="Visible" HintText="搜索插件名称、作者或 ID" />
                <local:MyCard Margin="0,0,0,15" Visibility="Collapsed">
                    <StackPanel Margin="19,17,19,14">
                        <TextBlock x:Name="TextRepoInfo"
                                   Text="正在加载插件列表..."
                                   FontSize="13" TextWrapping="Wrap" />
                    </StackPanel>
                </local:MyCard>
                <local:MyCard x:Name="CardPlugins" UseAnimation="False" Visibility="Collapsed">
                    <StackPanel x:Name="PanPlugins" Margin="12" />
                </local:MyCard>
            </StackPanel>
        </local:MyScrollViewer>
        <local:MyCard HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"
                      x:Name="PanLoad" UseAnimation="False" Margin="40,50">
            <local:MyLoading Text="正在获取插件商店列表" TextError="插件商店列表获取失败" Margin="20,20,20,17"
                             x:Name="Load" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </local:MyCard>
    </Grid>
</local:MyPageRight>
