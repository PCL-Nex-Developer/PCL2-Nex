<local:MyPageRight x:Class="PCL.PageDownloadPluginStore"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyPageRight.Resources>
        <Style x:Key="PluginSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="38" Height="20" Background="Transparent">
                            <Border CornerRadius="10" Background="{DynamicResource ColorBrushGray6}" />
                            <Border x:Name="TrackChecked" CornerRadius="10" Opacity="0"
                                    Background="{DynamicResource ColorBrush3}" />
                            <Grid Width="16" Height="16" HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="KnobTransform" />
                                </Grid.RenderTransform>
                                <Ellipse Fill="{DynamicResource ColorBrushGray1}" />
                                <Ellipse x:Name="KnobChecked" Fill="White" Opacity="0" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="18" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CircleEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TrackChecked"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="KnobChecked"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CircleEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TrackChecked"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="KnobChecked"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PluginStatusButtonStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource ColorBrushGray2}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border" CornerRadius="4" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource ColorBrushGray7}"
                                BorderBrush="{DynamicResource ColorBrushGray5}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ColorBrushGray6}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ColorBrush6}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ColorBrush3}" />
                                <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:MyPageRight.Resources>
    <Grid>
        <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
            <StackPanel x:Name="PanMain" Margin="25">
                <local:MySearchBox x:Name="PanSearchBox" Margin="0,0,0,15"
                                   SearchButtonVisibility="Visible" HintText="搜索插件名称、作者、ID、分组或标签" />
                <local:MyCard Margin="0,0,0,15">
                    <Grid Margin="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="来源" VerticalAlignment="Center" Margin="5,0" />
                        <local:MyComboBox x:Name="ComboSourceGroup" Grid.Column="1" MaxDropDownHeight="320">
                            <local:MyComboBoxItem Content="全部" Tag="" IsSelected="True" />
                        </local:MyComboBox>
                        <TextBlock Text="标签" Grid.Column="2" VerticalAlignment="Center" Margin="5,0" />
                        <local:MyComboBox x:Name="ComboTag" Grid.Column="3" MaxDropDownHeight="320">
                            <local:MyComboBoxItem Content="全部" Tag="" IsSelected="True" />
                        </local:MyComboBox>
                        <TextBlock Text="排序" Grid.Column="4" VerticalAlignment="Center" Margin="5,0" />
                        <local:MyComboBox x:Name="ComboSort" Grid.Column="5" MaxDropDownHeight="320">
                            <local:MyComboBoxItem Content="默认顺序" Tag="default" IsSelected="True" />
                            <local:MyComboBoxItem Content="最近更新" Tag="updated" />
                            <local:MyComboBoxItem Content="名称 A-Z" Tag="name-asc" />
                            <local:MyComboBoxItem Content="名称 Z-A" Tag="name-desc" />
                        </local:MyComboBox>
                        <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right">
                            <local:MyIconButton x:Name="BtnFilterReset" SvgIcon="lucide/rotate-ccw" ToolTip="重置筛选" LogoScale="0.9" />
                        </StackPanel>

                        <DockPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7" LastChildFill="False">
                            <TextBlock Text="状态" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="5,0" />
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton x:Name="CheckStatusArchived" Content="Archived"
                                              Style="{StaticResource PluginStatusButtonStyle}" />
                                <ToggleButton x:Name="CheckStatusDisabled" Content="Disabled"
                                              Style="{StaticResource PluginStatusButtonStyle}" />
                                <ToggleButton x:Name="CheckStatusFork" Content="Fork"
                                              Style="{StaticResource PluginStatusButtonStyle}" />
                            </StackPanel>
                            <Grid DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="SwitchShowOtherDevelopers" VerticalAlignment="Center"
                                              Style="{StaticResource PluginSwitchStyle}" />
                                <TextBlock Grid.Column="1" Text="显示来自非官方开发者的内容" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="7,0,5,0" />
                            </Grid>
                        </DockPanel>
                    </Grid>
                </local:MyCard>
                <StackPanel x:Name="PanPlugins" Visibility="Collapsed" />
            </StackPanel>
        </local:MyScrollViewer>
        <local:MyCard HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"
                      x:Name="PanLoad" UseAnimation="False" Margin="40,50">
            <local:MyLoading Text="正在获取插件商店列表" TextError="插件商店列表获取失败" Margin="20,20,20,17"
                             x:Name="Load" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </local:MyCard>
    </Grid>
</local:MyPageRight>
