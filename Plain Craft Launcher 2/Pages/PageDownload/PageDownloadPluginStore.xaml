<local:MyPageRight x:Class="PCL.PageDownloadPluginStore"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25">
            <local:MySearchBox x:Name="PanSearchBox" Margin="0,0,0,15" SearchButtonVisibility="Visible" HintText="搜索插件名称、作者或 ID" />
            <local:MyCard Margin="0,0,0,15">
                <StackPanel Margin="19,17,19,14">
                    <TextBlock x:Name="TextRepoInfo"
                               Text="正在加载插件列表..."
                               FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardPlugins" UseAnimation="False">
                <StackPanel x:Name="PanPlugins" Margin="12">
                    <TextBlock x:Name="TextLoading"
                               Text="正在从仓库获取插件列表..."
                               FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
