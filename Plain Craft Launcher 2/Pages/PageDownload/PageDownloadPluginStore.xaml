<local:MyPageRight x:Class="PCL.PageDownloadPluginStore"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25">
            <local:MyCard HorizontalAlignment="Center" SnapsToDevicePixels="True" x:Name="PanLoad" UseAnimation="False" Margin="0,0,0,15">
                <local:MyLoading Text="正在从插件市场获取插件列表..." Margin="20" x:Name="Load"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
            </local:MyCard>
            <local:MyCard x:Name="CardPlugins" UseAnimation="False">
                <StackPanel Margin="12">
                    <local:MySearchBox x:Name="PanSearchBox" Margin="0,0,0,12" SearchButtonVisibility="Visible" HintText="搜索插件名称、作者或 ID" />
                    <StackPanel x:Name="PanPlugins" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
