                        <Separator />
                        <local:MyMenuItem Click="BtnRemove_Click"
                                          Header="{DynamicResource Instance.Server.Card.Remove}"
                                          Icon="M683.514192 1023.999519H340.485808A154.527713 154.527713 0 0 1 186.336081 884.785983L129.317406 325.755552a39.082648 39.082648 0 0 1 77.762111-7.937715l57.053038 559.030431a76.559427 76.559427 0 0 0 76.376161 68.976791l57.053038-559.030431a39.082648 39.082648 0 1 1 77.762112 7.937715l-57.053039 559.030431A154.516259 154.516259 0 0 1 683.514192 1023.999519z" />
                    </ContextMenu>
                </local:MyIconButton.ContextMenu>
            </local:MyIconButton>
        </StackPanel>
    </Grid>
</local:MyCard>
