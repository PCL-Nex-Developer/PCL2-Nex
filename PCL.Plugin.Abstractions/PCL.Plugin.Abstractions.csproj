<Project Sdk="Microsoft.NET.Sdk">
    <!--
        PCL Plugin SDK — 纯契约程序集。
        此项目不依赖 PCL.Core，插件作者只需引用本程序集即可开发。
        运行时由 PCL.Core.App.Plugins.PluginHost 提供 IPluginHost 的实现。

        许可证：Apache License 2.0（与 PCL.Core 一致）。
    -->
    <PropertyGroup>
        <Nullable>enable</Nullable>
        <TargetFramework>net8.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <RootNamespace>PCL.Plugin.Abstractions</RootNamespace>
        <AssemblyTitle>PCL.Plugin.Abstractions</AssemblyTitle>
        <AssemblyName>PCL.Plugin.Abstractions</AssemblyName>
        <Description>PCL Nex 插件开发 SDK 契约</Description>
        <Company>PCL Nex</Company>
        <Product>PCL.Plugin.Abstractions</Product>
        <PackageId>PlainCraftLauncher.Plugin.Abstractions</PackageId>
        <Authors>PCL Nex</Authors>
        <PackageTags>plaincraftlauncher;pcl;pcl-nex;plugin;sdk;launcher</PackageTags>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryType>git</RepositoryType>
        <Copyright>Copyright © PCL Nex</Copyright>
        <AssemblyVersion>1.2.1.0</AssemblyVersion>
        <FileVersion>1.2.1.0</FileVersion>
        <Version>1.2.1</Version>
        <LangVersion>14.0</LangVersion>
        <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <!-- 作为 SDK 分发：保持纯契约，不内联任何实现 -->
        <IsPackable>true</IsPackable>
    </PropertyGroup>
</Project>
